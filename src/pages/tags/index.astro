---
import { getAndGroupUniqueTags } from "../../lib/utils";
import TagsBarChart from "../../components/react/TagsBarChart";
import IndexPageLayout from "../../layouts/IndexPageLayout.astro";
import WordCloud from "../../components/react/WordCloud";

const tagsMap = await getAndGroupUniqueTags();

const tags = tagsMap.keys();

const tagsWithFrequency: any[] = [];

tagsMap.forEach((value, key) => {
  tagsWithFrequency.push({ value: key, count: value.length });
});

// sort tags by frequency
tagsWithFrequency.sort((a: any, b: any) => b.count - a.count);
---

<IndexPageLayout
  title="Compétences & Tags"
  description="Toutes les technologies, compétences et mots-clés abordés dans ce portfolio."
  subTitle="Compétences & Mots-clés"
>
  <div class="flex flex-col gap-4">
    <div class="overflow-auto">
      <h3 class="mb-2 text-lg font-bold">Répartition</h3>
      <TagsBarChart tags={tagsWithFrequency.slice(0, 10)} client:load />
    </div>
    <div>
      <h3 class="mb-2 text-lg font-bold">Nuage de mots</h3>
      <WordCloud words={tagsWithFrequency} client:load />
      <blockquote class="mt-6 border-l-2 pl-6 text-xs font-light italic">
        Vous pouvez cliquer sur les mots-clés ci-dessus pour découvrir tous les
        projets et expériences associés.
      </blockquote>
    </div>
  </div>
</IndexPageLayout>
