---
import { Button } from "../ui/button";
import { PROFILE } from "../../content/profileData";
import {
  Linkedin,
  Github,
  Mail,
  Youtube,
  Twitter,
  Rss,
  Book,
  PanelsTopLeft,
} from "lucide-react";
---

<div class="flex h-full w-full animate-appear">
  <div class="flex flex-col justify-between gap-4 md:max-h-[300px]">
    <div class="flex h-full flex-col">
      <p class="m-0 text-xl font-light">
        Salut, moi c'est
        <b class="font-bold">{PROFILE.firstName}</b>.
      </p>
      <ul class="pt-4 flex flex-col gap-2">
        {
          PROFILE.shortIntros.map((intro, index) => (
            <li class={index === 3 ? "mt-4" : ""}>{intro}</li>
          ))
        }
      </ul>
    </div>
    <div class="flex gap-4">
      <a
        href={PROFILE.links.github}
        aria-label="github profile"
        target="_blank"
      >
        <Button aria-label="github profile">
          <Github />
          <span class="sr-only">Profil GitHub</span>
        </Button>
      </a>
      {
        PROFILE.links?.linkedin && (
          <a
            href={PROFILE.links.linkedin}
            aria-label="linkedin profile"
            target="_blank"
          >
            <Button aria-label="linkedin profile">
              <Linkedin />
              <span class="sr-only">Profil LinkedIn</span>
            </Button>
          </a>
        )
      }
      {
        PROFILE.links?.mail && (
          <a href={PROFILE.links.mail} aria-label="mail contact">
            <Button aria-label="mail contact">
              <Mail />
              <span class="sr-only">Contact par email</span>
            </Button>
          </a>
        )
      }
    </div>
  </div>
  <img
    src={PROFILE.avatarUrl}
    class="pointer-events-none absolute bottom-[-20px] right-[-110px] z-[-1] max-h-[300px] w-auto select-none opacity-50 md:absolute md:bottom-auto md:right-[-20px] md:z-auto md:opacity-100"
    width="100%"
    height="auto"
    alt={`image of ${PROFILE.name}`}
  />
</div>
